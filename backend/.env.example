# ==============================================================================
# CiteClash Backend Configuration (.env)
# ==============================================================================

PROJECT_NAME="CiteClash API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# CORS Allowed Origins (JSON array format)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Database URL - Async PostgreSQL (Supabase / local PostgreSQL)
# Local fallback option: sqlite+aiosqlite:///./citeclash.db (can be used for instant zero-dependency testing)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/citeclash"
# DATABASE_URL="sqlite+aiosqlite:///./citeclash.db"

# JWT Authentication
JWT_SECRET_KEY="citeclash_super_secret_jwt_encryption_key_change_in_production_min_32_chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth2 Settings
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/auth/google/callback"

# Initial Super Admin (Auto-Seed on Startup)
FIRST_SUPER_ADMIN_EMAIL="admin@citeclash.com"
FIRST_SUPER_ADMIN_PASSWORD="AdminPassword@123"
FIRST_SUPER_ADMIN_NAME="CiteClash SuperAdmin"

# AI Visibility & Search Engines (Multi-LLM Runner)
# Free tiers: Gemini Flash & Groq Llama
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
ENABLE_GEMINI_GROUNDING=true
GROQ_API_KEY=""
OPENAI_API_KEY=""
PERPLEXITY_API_KEY=""
SERPER_API_KEY=""

# Billing & Subscriptions (Lemon Squeezy / Dodo Payments)
BILLING_PROVIDER="lemonsqueezy"
BILLING_WEBHOOK_SECRET="citeclash_whsec_super_secret_signing_key_32_chars"
BILLING_DEV_SANDBOX_MODE=True
